# Required: application security and public URL
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SITE_URL=https://wine.example.com

# Required: initial administrator (used only when the username does not exist)
ADMIN_USER=admin
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=replace-with-a-strong-password

# Optional: control new account registration
DJANGO_ENABLE_SIGNUPS=False
DJANGO_ENABLE_SOCIAL_SIGNUPS=True

# Optional: configure SMTP to send emails; otherwise emails are logged
# Enable either TLS or SSL, not both
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USE_SSL=False
DJANGO_DEFAULT_FROM_EMAIL=

# Optional: configure AI-powered wine label scanning
AI_MODEL=
AI_API_KEY=
